# Copy this file to .env and fill in your MySQL password.

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=food_rescue

# --- API ---
PORT=5000
JWT_SECRET=replace-with-any-long-random-text
CLIENT_ORIGIN=http://localhost:5173

# --- WhatsApp Business Cloud API (optional) ---
# Leave blank to use click-to-chat links only. See docs/WHATSAPP.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
